   "source": [
    "# Founder Fade Curve OSS Survival Analysis\n",
    "\n",
    "This demo replicates the analysis comparing founder fade-curve descriptors against static features for predicting OSS project survival after founder departure.\n",
    "\n",
    "The analysis extracts trajectory features from monthly founder contribution time series and combines them with static features at departure time to predict project survival using logistic regression."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Install dependencies\n",
    "import subprocess, sys\n",
    "def _pip(*a): subprocess.check_call([sys.executable, '-m', 'pip', 'install', '-q', *a])\n",
    "\n",
    "# Core packages (pre-installed on Colab, install locally to match Colab env)\n",
    "if 'google.colab' not in sys.modules:\n",
    "    _pip('numpy==2.0.2', 'pandas==2.2.2', 'scikit-learn==1.6.1', 'scipy==1.16.3', 'matplotlib==3.10.0')\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Imports\n",
    "import json\n",
    "import resource\n",
    "import sys\n",
    "from pathlib import Path\n",
    "\n",
    "import numpy as np\n",
    "from loguru import logger\n",
    "from scipy import stats\n",
    "from sklearn.linear_model import LogisticRegression\n",
    "from sklearn.metrics import (\n",
    "    accuracy_score,\n",
    "    auc,\n",
    "    f1_score,\n",
    "    precision_score,\n",
    "    recall_score,\n",
    "    roc_curve,\n",
    ")\n",
    "from sklearn.model_selection import StratifiedKFold\n",
    "from sklearn.preprocessing import StandardScaler\n",
    "\n",
    "# Additional imports for visualization\n",
    "import matplotlib.pyplot as plt\n",
    "%matplotlib inline"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
