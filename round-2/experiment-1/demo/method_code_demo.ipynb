    "# Override load_data function to use already loaded data\n",
    "def load_data() -> list[dict]:\n",
    "    \"\"\"Load examples from the already loaded data.\"\"\"\n",
    "    examples = data[\"datasets\"][0][\"examples\"]\n",
    "    logger.info(f\"Loaded {len(examples)} projects\")\n",
    "    return examples\n"
