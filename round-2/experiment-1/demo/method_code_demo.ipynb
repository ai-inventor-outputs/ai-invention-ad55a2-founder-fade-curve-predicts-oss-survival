   "source": [
    "# Step 4: Helper Functions\\n",
    "\\n",
    "Define helper functions for data parsing and fade descriptor computation."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def parse_input(ex):\n",
    "    \"\"\"Safely parse input JSON from an example.\"\"\"\n",
    "    inp = ex.get('input', '{}')\n",
    "    if isinstance(inp, str):\n",
    "        try:\n",
    "            return json.loads(inp)\n",
    "        except json.JSONDecodeError:\n",
    "            return {}\n",
    "    return inp if isinstance(inp, dict) else {}\n",
    "\n",
    "\n",
    "def compute_fade_descriptors(month_indices, founder_shares, total_months):\n",
    "    if len(month_indices) < 3:\n",
    "        return {\n",
    "            'S_slope': 0.0, 'S_slope_norm': 0.0,\n",
    "            'S_convex': 0.0, 'S_convex_norm': 0.0,\n",
    "            'S_decline_start': 1.0,\n",
    "            'S_cliff': 0.0,\n",
    "            'S_plateau': 0,\n",
    "            'S_fade_idx': 0.5\n",
    "        }\n",
    "    t = np.array(month_indices, dtype=float)\n",
    "    y = np.array(founder_shares, dtype=float)\n",
    "\n",
    "    # Descriptor 1: Linear Slope\n",
    "    slope, intercept, r_value, p_value, std_err = stats.linregress(t, y)\n",
    "    S_slope = slope\n",
    "    S_slope_norm = slope / y[0] if y[0] > 0 else 0.0\n",
    "\n",
    "    # Descriptor 2: Convexity\n",
    "    coeffs = np.polyfit(t, y, 2)\n",
    "    S_convex = coeffs[0]\n",
    "    S_convex_norm = coeffs[0] / y[0] if y[0] > 0 else 0.0\n",
    "\n",
    "    # Descriptor 3: Decline Onset Time\n",
    "    dydt = np.gradient(y, t)\n",
    "    threshold = DECLINE_THRESHOLD  # Using config value\n",
    "    decline_indices = np.where(dydt < -threshold)[0]\n",
    "    if len(decline_indices) > 0:\n",
    "        S_decline_start = min(1.0, max(0.0, decline_indices[0] / total_months)) if total_months > 0 else 1.0\n",
    "    else:\n",
    "        S_decline_start = 1.0\n",
    "\n",
    "    # Descriptor 4: Cliff Score\n",
    "    n = len(y)\n",
    "    prior_avg = np.mean(y[max(0, n-6):max(0, n-2)])\n",
    "    final_avg = np.mean(y[max(0, n-2):n])\n",
    "    S_cliff = max(0.0, min(1.0, (prior_avg - final_avg) / prior_avg)) if prior_avg > 0 else 0.0\n",
    "\n",
    "    # Descriptor 5: Plateau-then-Cliff Indicator\n",
    "    if S_decline_start > 0.5 and n >= 4:\n",
    "        pre_decline_var = np.var(y[:int(S_decline_start * n)]) if int(S_decline_start * n) > 1 else 0\n",
    "        total_var = np.var(y)\n",
    "        S_plateau = 1 if (total_var > 0 and pre_decline_var < 0.5 * total_var) else 0\n",
    "    else:\n",
    "        S_plateau = 0\n",
    "\n",
    "    # Descriptor 6: Composite Fade Index\n",
    "    S_fade_idx = 1.0 - S_cliff\n",
    "    if S_slope < 0:\n",
    "        S_fade_idx += 0.3\n",
    "    if S_plateau:\n",
    "        S_fade_idx -= 0.2\n",
    "    S_fade_idx = max(0.0, min(1.0, S_fade_idx))\n",
    "\n",
    "    return {\n",
    "        'S_slope': round(S_slope, 6), 'S_slope_norm': round(S_slope_norm, 6),\n",
    "        'S_convex': round(S_convex, 6), 'S_convex_norm': round(S_convex_norm, 6),\n",
    "        'S_decline_start': round(S_decline_start, 4),\n",
    "        'S_cliff': round(S_cliff, 4),\n",
    "        'S_plateau': int(S_plateau),\n",
    "        'S_fade_idx': round(S_fade_idx, 4)\n",
    "    }"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# Step 5: Process Project Data\\n",
    "\\n",
    "Extract projects from demo data and compute fade descriptors."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def process_project(pid, examples):\n",
    "    try:\n",
    "        sorted_ex = sorted(examples, key=lambda x: x.get('metadata_month_index', 0))\n",
    "        month_indices = [ex.get('metadata_month_index', 0) for ex in sorted_ex]\n",
    "        commit_shares = [parse_input(ex).get('founder_commit_share', 0) for ex in sorted_ex]\n",
    "        merge_shares = [parse_input(ex).get('founder_merge_share', 0) for ex in sorted_ex]\n",
    "        review_shares = [parse_input(ex).get('founder_review_share', 0) for ex in sorted_ex]\n",
    "\n",
    "        if len(month_indices) < MIN_MONTHS_THRESHOLD:  # Using config value\n",
    "            return None\n",
    "\n",
    "        total_months = max(month_indices) - min(month_indices) + 1 if month_indices else 1\n",
    "        combined_share = [(c + m + r) / 3 for c, m, r in zip(commit_shares, merge_shares, review_shares)]\n",
    "        fade_desc = compute_fade_descriptors(month_indices, combined_share, total_months)\n",
    "\n",
    "        last_ex = sorted_ex[-1]\n",
    "        last_input = parse_input(last_ex)\n",
    "\n",
    "        # Determine label (1=survived, 0=collapsed)\n",
    "        label = None\n",
    "        for ex in sorted_ex:\n",
    "            output = ex.get('output', '')\n",
    "            if output in ['survived', 'collapsed', 'not_recovered', 'recovered']:\n",
    "                label = 1 if output in ['survived', 'recovered'] else 0\n",
    "                break\n",
    "\n",
    "        if label is None:\n",
    "            return None\n",
    "\n",
    "        # Extract static features from demo data\n",
    "        static_features = last_input.get('static_features', {})\n",
    "        \n",
    "        return {\n",
    "            'project_id': pid,\n",
    "            'label': label,\n",
    "            'static_features': static_features,\n",
    "            'fade_descriptors': fade_desc,\n",
    "            'n_months': len(month_indices),\n",
    "            'examples': sorted_ex\n",
    "        }\n",
    "    except Exception as e:\n",
    "        logger.warning(f\"Error processing project {pid}: {e}\")\n",
    "        return None"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# Step 6: Load and Process Demo Data\\n",
    "\\n",
    "Convert demo data format to project trajectories for analysis."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "logger.info(\"STEP 1: Loading demo data...\")\n",
    "projects_dict = {}\n",
    "all_examples = []\n",
    "\n",
    # Extract examples from demo data\n",
    "for dataset in data['datasets']:\n",
    "    for ex in dataset['examples']:\n",
    "        # Parse input to get project_id\n",
    "        input_dict = json.loads(ex['input'])\n",
    "        pid = input_dict.get('project_id', 'unknown')\n",
    "        if pid not in projects_dict:\n",
    "            projects_dict[pid] = []\n",
    "        projects_dict[pid].append(ex)\n",
    "        all_examples.append(ex)\n",
    "\n",
    "logger.info(f\"Loaded {len(all_examples)} total examples\")\n",
    "logger.info(f\"Found {len(projects_dict)} unique projects\")\n",
    "\n",
    "# Process each project\n",
    "project_data = []\n",
    "for pid, examples in projects_dict.items():\n",
    "    proj = process_project(pid, examples)\n",
    "    if proj is not None:\n",
    "        project_data.append(proj)\n",
    "\n",
    "logger.info(f\"Projects after processing: {len(project_data)}\")\n",
    "\n",
    "# Check minimum projects threshold\n",
    "if len(project_data) < MIN_PROJECTS_THRESHOLD:  # Using config value\n",
    "    logger.error(f\"Too few projects for analysis: {len(project_data)} < {MIN_PROJECTS_THRESHOLD}\")\n",
    "    # Continue anyway for demo with warning\n",
    "    logger.warning(\"Continuing with fewer projects than ideal for demo\")\n",
    "\n",
    "# Label distribution\n",
    "labels = [p['label'] for p in project_data]\n",
    "n_survived = sum(labels)\n",
    "n_collapsed = len(labels) - n_survived\n",
    "logger.info(f\"Label balance: {n_survived} survived, {n_collapsed} collapsed\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# Step 7: Feature Engineering\\n",
    "\\n",
    "Build feature matrices from static features and fade descriptors."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "logger.info(\"STEP 2: Building feature matrices...\")\n",
    "static_rows, fade_rows, interaction_rows = [], [], []\n",
    "for proj in project_data:\n",
    "    sf = proj['static_features']\n",
    "    fd = proj['fade_descriptors']\n",
    "    cont = sf.get('contributor_count_at_departure', 1)\n",
    "    bf = sf.get('bus_factor_at_departure', 1)\n",
    "    static_rows.append([\n",
    "        sf.get('bus_factor_at_departure', 0),\n",
    "        sf.get('contributor_count_at_departure', 0),\n",
    "        math.log1p(sf.get('stars_at_departure', 0)),\n",
    "        math.log1p(sf.get('file_count_at_departure', 0)),\n",
    "        sf.get('repo_age_days_at_departure', 0) / 365.0,\n",
    "        math.log1p(sf.get('commits_before_departure', 0)),\n",
    "        math.log1p(sf.get('commits_after_departure', 0)),\n",
    "    ])\n",
    "    fade_rows.append([\n",
    "        fd['S_slope_norm'], fd['S_convex_norm'], fd['S_decline_start'],\n",
    "        fd['S_cliff'], fd['S_plateau'], fd['S_fade_idx'],\n",
    "    ])\n",
    "    interaction_rows.append([fd['S_fade_idx'] * cont, fd['S_cliff'] * bf])\n",
    "\n",
    "static_names = ['bus_factor', 'contributor_count', 'stars_log', 'file_count_log',\n",
    "                    'repo_age_years', 'commits_before_log', 'commits_after_log']\n",
    "fade_names = ['S_slope_norm', 'S_convex_norm', 'S_decline_start', 'S_cliff', 'S_plateau', 'S_fade_idx']\n",
    "interaction_names = ['fade_idx_x_contributors', 'cliff_x_bus_factor']\n",
    "all_names = static_names + fade_names + interaction_names\n",
    "\n",
    "X_static = np.array(static_rows)\n",
    "X_fade = np.array(fade_rows)\n",
    "X_combined = np.hstack([X_static, X_fade, np.array(interaction_rows)])\n",
    "y = np.array(labels)\n",
    "\n",
    "logger.info(f\"Feature matrix shapes - Static: {X_static.shape}, Fade: {X_fade.shape}, Combined: {X_combined.shape}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# Step 8: Model Training Functions\\n",
    "\\n",
    "Define functions for training logistic regression and random forest models with cross-validation."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def train_model(X, y, model_type='logistic'):\n",
    "    \"\"\"Train model with cross-validation and return metrics.\"\"\"\n",
    "    if len(np.unique(y)) < 2:\n",
    "        logger.warning(\"Only one class present, returning default metrics\")\n",
    "        return {\n",
    "            'auc_mean': 0.5, 'auc_std': 0.0,\n",
    "            'logloss_mean': 0.693, 'logloss_std': 0.0,\n",
    "            'all_probas': [], 'all_labels': []\n",
    "        }\n",
    "\n",
    "    # Use configured CV folds\n",
    "    skf = StratifiedKFold(n_splits=CV_FOLDS, shuffle=True, random_state=RANDOM_STATE)\n",
    "    \n",
    "    aucs = []\n",
    "    loglosses = []\n",
    "    all_probas = []\n",
    "    all_labels = []\n",
    "\n",
    "    for train_idx, val_idx in skf.split(X, y):\n",
    "        X_train, X_val = X[train_idx], X[val_idx]\n",
    "        y_train, y_val = y[train_idx], y[val_idx]\n",
    "        \n",
    "        if model_type == 'logistic':\n",
    "            model = LogisticRegression(\n",
    "                penalty='l2', C=1.0, class_weight='balanced',\n",
    "                max_iter=LOGISTIC_MAX_ITER,  # Using config value\n",
    "                random_state=RANDOM_STATE, solver='lbfgs'\n",
    "            )\n",
    "        elif model_type == 'rf':\n",
    "            model = RandomForestClassifier(\n",
    "                n_estimators=RF_N_ESTIMATORS,  # Using config value\n",
    "                max_depth=RF_MAX_DEPTH,        # Using config value\n",
    "                min_samples_split=RF_MIN_SAMPLES_SPLIT,  # Using config value\n",
    "                min_samples_leaf=RF_MIN_SAMPLES_LEAF,    # Using config value\n",
    "                random_state=RANDOM_STATE,\n",
    "                class_weight='balanced'\n",
    "            )\n",
    "        else:\n",
    "            raise ValueError(f\"Unknown model type: {model_type}\")\n",
    "        \n",
    "        # Handle case where training data has only one class\n",
    "        if len(np.unique(y_train)) < 2:\n",
    "            # Predict majority class\n",
    "            maj_class = np.bincount(y_train).argmax()\n",
    "            probas = np.full((len(y_val), 2), 0.5)\n",
    "            probas[:, maj_class] = 0.7\n",
    "            probas[:, 1-maj_class] = 0.3\n",
    "        else:\n",
    "            model.fit(X_train, y_train)\n",
    "            probas = model.predict_proba(X_val)\n",
    "        \n",
    "        # Calculate metrics\n",
    "        if len(np.unique(y_val)) > 1:\n",
    "            auc = roc_auc_score(y_val, probas[:, 1])\n",
    "            logloss = log_loss(y_val, probas)\n",
    "        else:\n",
    "            auc = 0.5\n",
    "            logloss = 0.693\n",
    "        \n",
    "        aucs.append(auc)\n",
    "        loglosses.append(logloss)\n",
    "        all_probas.extend(probas[:, 1])\n",
    "        all_labels.extend(y_val)\n",
    "\n",
    "    return {\n",
    "        'auc_mean': np.mean(aucs),\n",
    "        'auc_std': np.std(aucs) if len(aucs) > 1 else 0.0,\n",
    "        'logloss_mean': np.mean(loglosses),\n",
    "        'logloss_std': np.std(loglosses) if len(loglosses) > 1 else 0.0,\n",
    "        'all_probas': np.array(all_probas),\n",
    "        'all_labels': np.array(all_labels)\n",
    "    }"
   ]
