\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Predictive performance of three model variants on the 14-project pilot cohort. Static features achieve AUC = 0.857, shape features alone perform below chance (AUC = 0.408), and the combined model reaches AUC = 0.898. Error bars show 95\% bootstrap confidence intervals from 10,000 resamples. The net reclassification improvement for adding shape features is negative (NRI = $-$0.143, $p$ = 0.571).}}{10}{figure.2}\protected@file@percent }
\newlabel{fig:fig2}{{2}{10}{Predictive performance of three model variants on the 14-project pilot cohort. Static features achieve AUC = 0.857, shape features alone perform below chance (AUC = 0.408), and the combined model reaches AUC = 0.898. Error bars show 95\% bootstrap confidence intervals from 10,000 resamples. The net reclassification improvement for adding shape features is negative (NRI = $-$0.143, $p$ = 0.571)}{figure.2}{}}
